# Copia este archivo a .env para trabajar en tu ordenador.
# Estos valores son solo de desarrollo. Render genera los secretos de producción.

DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/crm
DATABASE_URL=postgres://app_user:app_user@localhost:5432/crm
JWT_SECRET=dev-only-change-me-please-32chars
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
WEB_ORIGIN=http://localhost:3000
PORT=3001

# Cola de trabajos e inbox en tiempo real (sin Redis, los webhooks y los envíos no funcionan).
REDIS_URL=redis://localhost:6379

# App de Meta (developers.facebook.com). Sin estos valores no se puede conectar Facebook ni recibir webhooks.
META_APP_ID=
META_APP_SECRET=
# Texto que tú eliges y que pegas en Meta como "token de verificación" del webhook.
META_WEBHOOK_VERIFY_TOKEN=
# Opcional. Versión de la Graph API (por defecto v25.0).
META_GRAPH_VERSION=

# Sin esta clave, en tu ordenador el código sale en la terminal del API.
# En Render, sin esta clave, el registro se niega a enviar correos.
RESEND_API_KEY=
RESEND_FROM=

AUTH_SECRET=dev-only-change-me-please-32chars
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
API_URL=http://localhost:3001
